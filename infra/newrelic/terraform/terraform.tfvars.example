# Copie para terraform.tfvars e preencha. NUNCA comite o terraform.tfvars.
#
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform apply

newrelic_account_id = 1234567
newrelic_api_key    = "NRAK-<sua-user-api-key>" # User API key
newrelic_region     = "US"

environment  = "production"
app_name     = "mechanic-shop (Production)" # deve casar com NEW_RELIC_APP_NAME
cluster_name = "eks-mechanic-shop"          # deve casar com global.cluster do nri-bundle

health_check_url = "https://api.mechanic-shop.example.com/actuator/health"
alert_email      = "equipe@example.com"
